+        return false;
+    }
+    for (int i = 0; i < sched->n_splits; ++i) {
+        const ggml_backend_sched_split & split = sched->splits[i];
+        if (split.backend_id == 0) {
+            continue;
+        }
+        for (int j = 0; j < split.graph.n_nodes; ++j) {
+            const ggml_tensor * node = split.graph.nodes[j];
