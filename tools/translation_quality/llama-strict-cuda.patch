+#if defined(GGML_TRANSLATEIT_STRICT_CUDA)
+// The CPU backend is structurally required by the scheduler. Keep it for
+// host inputs and metadata, but never dispatch model arithmetic to it.
+// Validate all splits before the first input copy or graph submission so a
+// later unsupported operation cannot yield a partially executed graph.
+static bool ggml_translateit_cuda_graph_admitted(ggml_backend_sched_t sched) {
+    if (sched->n_backends <= 0 || sched->backends[0] == nullptr) {
+        return false;
+    }
+    ggml_backend_dev_t primary = ggml_backend_get_device(sched->backends[0]);
+    ggml_backend_reg_t reg = primary ? ggml_backend_dev_backend_reg(primary) : nullptr;
+    const char * name = reg ? ggml_backend_reg_name(reg) : nullptr;
+    if (!primary || ggml_backend_dev_type(primary) != GGML_BACKEND_DEVICE_TYPE_GPU ||
+        !name || strcmp(name, "CUDA") != 0) {
+        GGML_LOG_ERROR("translateit:cuda_primary_required\n");
+        return false;
+    }
+    for (int i = 0; i < sched->n_splits; ++i) {
+        const ggml_backend_sched_split & split = sched->splits[i];
+        if (split.backend_id == 0) {
+            continue;
+        }
+        for (int j = 0; j < split.graph.n_nodes; ++j) {
+            const ggml_tensor * node = split.graph.nodes[j];
+            if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) &&
+                node->op != GGML_OP_NONE && !ggml_is_view_op(node->op)) {
+                GGML_LOG_ERROR("translateit:cuda_graph_placement_rejected (%s)\n",
+                               ggml_op_name(node->op));
+                return false;
+            }
+        }
+    }
+    return true;
+}
