{
  "schemaVersion": 1,
  "package": "TranslateIT Windows Development Requirements",
  "target": {
    "os": [
      "Windows 10 x64",
      "Windows 11 x64"
    ],
    "architecture": "x86_64",
    "productRuntime": "Windows desktop"
  },
  "policy": {
    "localOnlyRepositoryAuthority": true,
    "lockfilesRequired": true,
    "endUserMustNotRequireDeveloperToolchain": true,
    "statusMustNotInstallOrRepairAutomatically": true
  },
  "node": {
    "major": 24,
    "source": ".github/workflows/translateit-windows-local-validation.yml",
    "lockfile": "EngineData/Frontend/RustApp/package-lock.json"
  },
  "rust": {
    "minimum": "1.99.1",
    "source": "EngineData/Frontend/RustApp/src-tauri/Cargo.toml",
    "lockfile": "EngineData/Frontend/RustApp/src-tauri/Cargo.lock",
    "pinPolicy": "minimum compiler follows Cargo.toml and reviewed Cargo.lock MSRV facts; full dependency closure needs executed Cargo proof"
  },
  "python": {
    "version": "3.12.10",
    "source": "EngineData/Backend/LocalWorker/WorkerRuntime/.python-version",
    "lockfile": "EngineData/Backend/LocalWorker/WorkerRuntime/uv.lock"
  },
  "uv": {
    "minimum": "0.13.5",
    "source": "EngineData/Backend/LocalWorker/WorkerRuntime/pyproject.toml"
  },
  "tauri": {
    "major": 2,
    "source": "EngineData/Frontend/RustApp/package-lock.json + src-tauri/Cargo.lock"
  },
  "portable": {
    "node": {
      "version": "24.22.1",
      "url": "https://nodejs.org/dist/v24.22.1/node-v24.22.1-win-x64.zip",
      "sha256": "d2046d28c2c3dcd211ac5145c0bf30e2047ef9dfb306693c8c6e2eccd8b95fa5"
    },
    "uv": {
      "version": "0.13.5",
      "url": "https://github.com/astral-sh/uv/releases/download/0.13.5/uv-x86_64-pc-windows-msvc.zip",
      "sha256": "a38b8d1902b7cfbc76b423ba1bb456f623f42064cdc72628b6075b89afd1019a"
    },
    "rustup": {
      "version": "1.29.2",
      "url": "https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-pc-windows-msvc/rustup-init.exe",
      "sha256": "00f139da614dced87d3c3d4121c43eebdac3c1bf8a5ee86b9d80dfd71c8d70fd"
    },
    "rust": {
      "version": "1.99.1",
