[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/29/2026, 0.2.0.0
CatalogFile = TranslateITMic.cat
PnpLockDown = 1

[SourceDisksNames]
222="TRANSLATEITMIC Driver Disk","",222

[SourceDisksFiles]
TranslateITMic.sys=222

[SignatureAttributes]
TranslateITMic.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName%=TRANSLATEITMIC,NT$ARCH$.10.0

[TRANSLATEITMIC.NT$ARCH$.10.0]
%TRANSLATEITMIC_SA.DeviceDesc%=TRANSLATEITMIC_SA, ROOT\TranslateITCaptureMic

[DestinationDirs]
TRANSLATEITMIC_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; TRANSLATEITMIC_SA
;======================================================
[TRANSLATEITMIC_SA.CopyList]
TranslateITMic.sys

[TRANSLATEITMIC_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,TranslateITMic.sys
HKR,%MediaCategories%\%Guid.TranslateITCapture%,Name,,%MicArray1CustomName%

;
; For demo only, please review these power management settings for your architecture. 
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%TRANSLATEITMIC_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%TRANSLATEITMIC_SA.DeviceDesc%

;======================================================
; capture interfaces: mic array (internal: front)
;======================================================
[TRANSLATEITMIC.I.WaveMicArray1]
AddReg=TRANSLATEITMIC.I.WaveMicArray1.AddReg
[TRANSLATEITMIC.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TRANSLATEITMIC.WaveMicArray1.szPname%

[TRANSLATEITMIC.I.TopologyMicArray1]
AddReg=TRANSLATEITMIC.I.TopologyMicArray1.AddReg

[TRANSLATEITMIC.I.TopologyMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TRANSLATEITMIC.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; TRANSLATEITMIC_SA
;======================================================
[TRANSLATEITMIC_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=TRANSLATEITMIC_SA.CopyList
AddReg=TRANSLATEITMIC_SA.AddReg

[TRANSLATEITMIC_SA.NT.Interfaces]
;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, TRANSLATEITMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, TRANSLATEITMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, TRANSLATEITMIC.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, TRANSLATEITMIC.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, TRANSLATEITMIC.I.TopologyMicArray1

[TRANSLATEITMIC_SA.NT.Services]
AddService=TranslateITMic,0x00000002,TranslateITMic_Service_Inst

[TranslateITMic_Service_Inst]
DisplayName=%TranslateITMic.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TranslateITMic.sys

[TRANSLATEITMIC_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; Recording endpoint may be read by Windows audio users; privileged PCM writes
; use a different admin/SYSTEM-only control device ACL.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGX;;;BU)(A;;GRGX;;;RC)"


;======================================================
; WDF
;======================================================
[TRANSLATEITMIC_SA.NT.Wdf]
KmdfService = TranslateITMic, TRANSLATEITMIC_SA_WdfSect
[TRANSLATEITMIC_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable


KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

MediaCategories="MediaCategories"
Guid.TranslateITCapture="{5f39e1d7-53aa-42fc-8c94-f8efaf36e132}"

ProviderName = "OpenITStudios"
MfgName      = "OpenITStudios"
MsCopyRight  = "Microsoft Corporation; modifications OpenITStudios"

TRANSLATEITMIC_SA.DeviceDesc="TranslateIT Capture Microphone"
TranslateITMic.SvcDesc="TranslateIT Capture Microphone Driver"

;; friendly names

TRANSLATEITMIC.WaveMicArray1.szPname="TranslateIT Meeting Microphone"
TRANSLATEITMIC.TopologyMicArray1.szPname="TranslateIT Meeting Microphone"

MicArray1CustomName= "TranslateIT Meeting Microphone"

